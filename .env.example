# Number the emergency screen dials (tel: link). Configure per deployment.
NEXT_PUBLIC_EMERGENCY_NUMBER=112

# Anthropic key for the triage agent. Without it the app uses a simple built-in stub.
ANTHROPIC_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-5-5).
# TRIAGE_MODEL=

# Neon Postgres connection string. Without it results are kept in memory only.
DATABASE_URL=
