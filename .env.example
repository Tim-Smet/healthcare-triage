# Optional. If set, the emergency buttons become tel: links to this number.
# Leave empty on a prototype so nothing can dial anyone.
NEXT_PUBLIC_EMERGENCY_NUMBER=

# Anthropic key for the triage agent. Without it the app uses a simple built-in stub.
ANTHROPIC_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-5-5).
# TRIAGE_MODEL=

# Neon Postgres connection string. Without it results are kept in memory only.
DATABASE_URL=
# Optional. Direct connection string used for migrations (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=
